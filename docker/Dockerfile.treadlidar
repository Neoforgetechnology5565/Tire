# Offline analysis image (no ROS needed). Open3D viewer needs a display; run the CLI headless.
FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libegl1 libgomp1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml requirements.txt ./
COPY src ./src
RUN pip install --no-cache-dir -e ".[test]"
COPY . .
CMD ["pytest", "-q"]
